# Logs. Anchored: a bare `logs` would also swallow any source folder called
# `logs`, which is how `game/scenes/logs/` once fell out of the commit.
/logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

/node_modules
/dist
/dist-ssr
*.local
.sim/
.pnpm-store/
.tmp-assets/
.tmp-originals/
.tmp-esbuild/
# Скриншоты и скрипты разбора кадра из ручных прогонов: не исходники.
.previews/
.tmp-previews/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Third-party art packs (see CREDITS.md); generated deploy assets are tracked.
assetspacks/
